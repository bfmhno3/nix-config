+     */
+    public static int getXSettingsScale() {
+        return xSettingsScale;
+    }
+
+    /**
+     * UI scale implied by a set of XSETTINGS values. Xft/DPI is in 1024ths of a
+     * dpi and is what most toolkits scale by, Gdk/WindowScalingFactor is the
+     * integer scale GDK itself uses; either one may be present, so the larger of
+     * the two is taken.
+     */
+    private static int scaleFromXSettings(Map<String, Object> settings) {
+        int scale = 1;
+        Object dpi = settings.get("Xft/DPI");
+        if (dpi instanceof Number number) {
+            scale = Math.max(scale, (int) Math.round(number.doubleValue() / 1024 / 96));
+        }
+        Object factor = settings.get("Gdk/WindowScalingFactor");
+        if (factor instanceof Number number) {
+            scale = Math.max(scale, number.intValue());
+        }
+        return scale;
+    }
